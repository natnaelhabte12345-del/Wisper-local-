GROQ_API_KEY=your_groq_api_key_here

# Optional: better accuracy for long dictations (>12 s). https://www.assemblyai.com
# ASSEMBLYAI_API_KEY=

# Optional, OFF by default. Save your recordings + transcripts locally (never uploaded).
# Number = days the AUDIO is kept; transcripts (small JSON) stay. 0 or unset = store nothing.
# WISPRWIN_KEEP_AUDIO_DAYS=30
